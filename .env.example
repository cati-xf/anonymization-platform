# Copy to .env and adjust, then load it before starting the app:
#   set -a; source .env; set +a
# Every variable is optional -- the value shown is the default.

# ── ASR ──────────────────────────────────────────────────────────────────────
# CTranslate2-converted CAMÕES Whisper model (see README "ASR model")
WHISPER_MODEL_DIR=./models/whisper_lv3_ft_ep_cpp_ct2
# Keep the Whisper model loaded between jobs (more VRAM, faster)
ASR_CACHE_MODEL=0

# ── Montreal Forced Aligner ──────────────────────────────────────────────────
# conda env holding MFA; MFA_BIN overrides the resolved binary path directly
MFA_CONDA_ENV=aligner
# MFA_BIN=/path/to/miniconda3/envs/aligner/bin/mfa
MFA_DICT=portuguese_mfa
MFA_ACOUSTIC=portuguese_mfa
MFA_BEAM=100
MFA_RETRY_BEAM=400

# ── F5-TTS ───────────────────────────────────────────────────────────────────
F5_TTS_DIR=$HOME/F5-TTS/F5-TTS
F5_TTS_CONDA_ENV=f5-tts
# F5_TTS_PYTHON=/path/to/miniconda3/envs/f5-tts/bin/python

# ── Background-noise separation ──────────────────────────────────────────────
# TUSS standalone_inference package (must contain pretrained_models/);
# bundled in third_party/ by default
# TUSS_DIR=./third_party/standalone_inference
DIARIZEN_CONDA_ENV=diarizen
# DIARIZEN_PYTHON=/path/to/miniconda3/envs/diarizen/bin/python
DIARIZEN_MODEL_ID=BUT-FIT/diarizen-wavlm-large-s80-md-v2

# ── Misc ─────────────────────────────────────────────────────────────────────
# ffmpeg to use when none is on PATH (default: the one bundled with imageio-ffmpeg)
# FFMPEG_BIN=/path/to/ffmpeg

# ── Text anonymization ───────────────────────────────────────────────────────
# 1 = never query Wikidata live, only the local cached index (anon_kb.db)
PRIVACY_MODE=0
# Optional LLM replacement source (Ollama)
TEXT_LLM_MODEL=gemma3:12b
TEXT_LLM_OLLAMA_HOST=http://localhost:11434
